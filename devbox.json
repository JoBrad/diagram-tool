{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "env_from": ".env",
  "packages": {
    "go": "1.27.1",
    "golangci-lint": "2.14.0",
    "postgresql_17": {
      "version": "latest",
      "disable_plugin": true
    }
  },
  "shell": {
    "init_hook": [
      "[ -f \"$DEVBOX_PROJECT_ROOT/certs/global-bundle.pem\" ] || curl -fsSL -o \"$DEVBOX_PROJECT_ROOT/certs/global-bundle.pem\" https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem"
    ],
    "scripts": {
      "psql": "psql \"host=$PGHOST port=$PGPORT user=$PGUSER dbname=$PGDATABASE sslmode=verify-full sslrootcert=./certs/global-bundle.pem\"",
      "build": "go build ./...",
      "test": "go test ./...",
      "lint": "golangci-lint run ./...",
      "run": "go run main.go",
      "coverage": [
        "go test -cover -coverprofile=coverage.txt ./...",
        "go tool go-test-coverage --config .testcoverage.yml"
      ],
      "deadcode": [
        "go tool deadcode ./..."
      ]
    }
  }
}
